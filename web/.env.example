# Copy to web/.env.local and restart `npm run dev` after changes.
# NEXT_PUBLIC_* is inlined at Next startup — a running server will not pick up edits.

# false / unset = frontend mock SSE (no API key required)
# true = POST /api/chat/stream (backend orchestrator)
NEXT_PUBLIC_USE_BACKEND=false

# Optional server-side LLM defaults (used when the request omits settings).
# The Settings modal stores values in the browser and sends them on each stream.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.7
